# Google API credentials (create OAuth 2.0 Client ID in Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Optional: override default redirect URI if using a tunnel or different host
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Stripe API key (get from https://dashboard.stripe.com/apikeys)
# Use test key for development, live key for production
STRIPE_API_KEY=sk_test_your_stripe_api_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Twilio credentials (get from https://www.twilio.com/console)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Server port
PORT=3000
BUSINESS_CONTEXT_PORT=3100
AUTOMATION_AGENT_PORT=3200
INTAKE_AGENT_PORT=3300
INVOICE_AGENT_PORT=3400
STRIPE_CONNECTOR_PORT=3500
PAYMENT_AGENT_PORT=3600
TAX_AGENT_PORT=3700
TWILIO_CONNECTOR_PORT=3800

# Calendar webhook URL (for Google Calendar push notifications)
# Set to your public HTTPS endpoint (e.g., ngrok tunnel)
CALENDAR_WEBHOOK_URL=https://your-public-domain.com/webhook
GOOGLE_CALENDAR_ID=primary

