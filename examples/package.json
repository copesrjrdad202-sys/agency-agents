{
  "name": "multi-agent-prototype-google-calendar",
  "version": "0.1.0",
  "private": true,
  "main": "googleCalendarConnector.ts",
  "scripts": {
    "start:connector": "ts-node-dev --respawn --transpile-only googleCalendarConnector.ts",
    "start:business": "ts-node-dev --respawn --transpile-only businessContextAgent.ts",
    "start:intake": "ts-node-dev --respawn --transpile-only intakeAgent.ts",
    "start:automation": "ts-node-dev --respawn --transpile-only automationAgent.ts",
    "start:invoice": "ts-node-dev --respawn --transpile-only invoiceAgent.ts",
    "start:payment": "ts-node-dev --respawn --transpile-only paymentAgent.ts",
    "start:tax": "ts-node-dev --respawn --transpile-only taxAgent.ts",
    "start:stripe": "ts-node-dev --respawn --transpile-only stripeConnectorLive.ts",
    "start:twilio": "ts-node-dev --respawn --transpile-only twilioConnectorLive.ts",
    "start:elevenlabs": "ts-node-dev --respawn --transpile-only elevenLabsConnector.ts",
    "start:calendar": "ts-node-dev --respawn --transpile-only calendarAgent.ts",
    "start:reminder": "ts-node-dev --respawn --transpile-only reminderAgent.ts",
    "start:pnl": "ts-node-dev --respawn --transpile-only pnlAgent.ts",
    "start:dashboard": "ts-node-dev --respawn --transpile-only dashboardAgent.ts",
    "start:social-broker": "ts-node-dev --respawn --transpile-only socialAccessBroker.ts",
    "start:social": "ts-node-dev --respawn --transpile-only socialMediaAutomationAgent.ts",
    "onboard": "ts-node-dev --respawn --transpile-only onboardGoogleClient.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json --outDir dist",
    "validate:prod": "node scripts/validate-production.mjs",
    "validate:no-spend": "node scripts/no-spend-validation.mjs",
    "validate:sandbox": "node scripts/sandbox-validation.mjs",
    "validate:social": "node scripts/social-validation.mjs",
    "package:prod": "node scripts/package-production.mjs",
    "deploy:prep": "npm run typecheck && npm run build && npm run validate:prod && npm run package:prod",
    "start:prod": "node dist/prodLauncher.js"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "googleapis": "^118.0.0",
    "nodemailer": "^7.0.0",
    "open": "^8.4.0",
    "stripe": "^22.5.0",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.2.5",
    "@types/nodemailer": "^8.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}
