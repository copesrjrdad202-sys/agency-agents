# Server
PORT=3950
NODE_ENV=development
# Public HTTPS URL Twilio (and other webhook callers) can reach this server at,
# e.g. https://voice.yourdomain.com or an ngrok/Cloudflare Tunnel URL while testing.
PUBLIC_BASE_URL=
# Where the SQLite multi-tenant database file is stored.
DATA_DIR=./data

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Google Cloud (Speech-to-Text & Text-to-Speech)
# Option A: path to a service account JSON key file on disk
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
# Option B: base64-encoded JSON key contents (used if the file above does not exist)
GOOGLE_APPLICATION_CREDENTIALS_BASE64=

GOOGLE_PROJECT_ID=your-gcp-project-id
TTS_VOICE_NAME=en-US-Neural2-F
TTS_LANGUAGE_CODE=en-US
STT_LANGUAGE_CODE=en-US

# Business config (used in the Claude system prompt)
BUSINESS_NAME=Acme Home Services
BUSINESS_TYPE=HVAC and Plumbing Repair
BUSINESS_HOURS=Mon-Fri 8am-6pm, Sat 9am-2pm
BUSINESS_SERVICE_AREA=Springfield metro area

# Calendar integration
# "mock" uses an in-memory calendar for demo/testing.
# "google" uses the real Google Calendar API directly. Use either the secure OAuth
# settings below or a service account credential with Calendar scope.
# "multi-agent" delegates to the Calendar Agent in ../examples of this repo's
# multi-agent-automation-system, so voice bookings share the same business
# calendar, reminders, and invoicing as the rest of that system.
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_ID=primary
# Recommended: user OAuth avoids creating a downloadable service-account key.
# Create a Desktop OAuth client in Google Cloud and enter its client ID/secret here.
# Then run: npm run authorize:calendar
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_OAUTH_REDIRECT_URI=http://127.0.0.1:53682/oauth2callback

# Multi-agent automation system integration (only used when CALENDAR_PROVIDER=multi-agent)
MULTI_AGENT_CALENDAR_URL=http://localhost:3401
MULTI_AGENT_BUSINESS_ID=default
MULTI_AGENT_AUTOMATION_URL=http://localhost:3200/process

# Make.com / n8n outbound webhook (optional) - called after a booking is confirmed
AUTOMATION_WEBHOOK_URL=

# Twilio telephony (customer forwards their existing business number here on
# no-answer/busy; see README "Telephony Setup" section)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth Token is REQUIRED regardless of whether you use API Keys below — it's the
# only credential Twilio supports for validating inbound webhook signatures.
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Optional (recommended): API Key SID/Secret for outbound API calls (buying
# numbers, etc.) instead of using the Auth Token directly. Create a "Standard"
# API Key in Twilio Console > Account > API keys & tokens. Leave blank to fall
# back to Account SID + Auth Token for outbound calls too.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Set to "false" only for local testing without a real Twilio account.
TWILIO_VALIDATE_SIGNATURE=true

# Admin API key protecting /api/admin/* business management endpoints and the
# provisioning script. Generate a long random string for production.
ADMIN_API_KEY=changeme-generate-a-long-random-string
